__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
data/
reports/
CLAUDE.md

# models/ is ignored except the LR artifact: it is 1.5MB and has to be in the
# Docker build context for the Render service to have anything to serve.
# (Written as models/* rather than models/ so git can still descend into it —
# a negation cannot re-include a file whose parent directory is excluded.)
models/*
!models/baseline/
models/baseline/*
!models/baseline/baseline_lr.joblib
# The frozen-encoder head is 5KB and is the entire deployable artifact for that
# variant — the encoder itself is pulled from the Hub at boot, so this file is the
# only thing the Streamlit and Space demos actually need from this repo.
!models/marbert_frozen_head.pt
