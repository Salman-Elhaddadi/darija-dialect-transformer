# models/ is ignored except the LR artifact: it is 1.5MB and has to be in the
# Docker build context for the Render service to have anything to serve.
# (Written as models/* rather than models/ so git can still descend into it —
# a negation cannot re-include a file whose parent directory is excluded.)
models/*
